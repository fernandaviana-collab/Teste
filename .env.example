# =============================================================
# Variáveis de Ambiente — FastTeam (Vercel + Supabase)
# =============================================================
# Copie este arquivo para .env.local e preencha os valores.
# No Vercel: adicione estas variáveis em Settings > Environment Variables.
# =============================================================

# -------------------------------------------------------
# DATABASE (Supabase)
# -------------------------------------------------------
# URL com PgBouncer (connection pooling) — usada pelo Prisma em runtime
# Formato Supabase: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# URL direta (sem PgBouncer) — usada pelo Prisma para migrations
# Formato Supabase: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL=

# -------------------------------------------------------
# AUTH (JWT)
# -------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d

# -------------------------------------------------------
# CORS
# -------------------------------------------------------
# Separe múltiplas origens por vírgula.
# Ex: https://testepeople.vercel.app,https://meudominio.com.br
ALLOWED_ORIGINS=

# -------------------------------------------------------
# OPENAI (opcional — IA para scoring de candidatos)
# -------------------------------------------------------
OPENAI_API_KEY=

# -------------------------------------------------------
# NODE
# -------------------------------------------------------
NODE_ENV=production
